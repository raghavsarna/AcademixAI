# Copy this file to .env and fill in the values. Never commit .env.

# Google Gemini API key (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Secret used to sign login tokens. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Optional overrides
# GEMINI_MODEL=gemini-3.1-flash-lite
# GEMINI_FAST_MODEL=gemini-3.1-flash-lite
# GEMINI_FALLBACK_MODEL=gemma-4-26b-a4b-it   # used when rate limited; "" disables
# DATABASE_URL=sqlite:///db/research.db
# ACCESS_TOKEN_EXPIRE_MINUTES=30
