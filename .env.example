# Copy this file to .env and fill in the values. Never commit .env.

# Google Gemini API key (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Secret used to sign login tokens. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# ---- Optional overrides (defaults shown)

# Database. SQLite locally; for Postgres use e.g. postgresql://user:password@host:5432/academixai
# DATABASE_URL=sqlite:///db/academixai.db

# Models. GEMINI_FALLBACK_MODEL is used when the main model is rate limited; set it to "" to disable.
# GEMINI_MODEL=gemini-3.1-flash-lite
# GEMINI_FAST_MODEL=gemini-3.1-flash-lite
# GEMINI_FALLBACK_MODEL=gemma-4-26b-a4b-it

# Uploads
# UPLOAD_DIR=uploads
# MAX_UPLOAD_MB=20

# Rate limits
# CHAT_REQUESTS_PER_MINUTE=10
# UPLOADS_PER_HOUR=10
# LOGIN_ATTEMPTS_PER_MINUTE=10
# SIGNUPS_PER_HOUR=10

# Login sessions and allowed browser origins (JSON list)
# ACCESS_TOKEN_EXPIRE_MINUTES=60
# CORS_ORIGINS=["http://localhost:3000"]
